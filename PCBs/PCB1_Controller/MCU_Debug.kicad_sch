  (text "STM32H573ZIT6 controller: native USB is the default PC data path. CP2102N debug UART population is DNP."
    (at 12.00 12.00 0)
    (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom))
    (uuid "4ac19c5b-3a60-4edb-80fa-3781113ba2a6")
  )

  (text "PB13/PB14 are reserved for UCPD CC1/CC2; sensor SPI2 uses PB10/PC2/PC3 instead."
    (at 12.00 22.00 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "c3c0d65f-bec5-4795-81c7-28c4a99f100d")
  )

  (text "BOOT0 and RESET use B3U tact switches. Indicator LEDs are active-low GPIO sinks."
    (at 12.00 32.00 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "64298f60-5f52-421d-b645-1271d9e2f2da")
  )

  (text "PA1 senses VBUS_FUSED through a 100k/100k divider; PG10 reads the eFuse fault pin."
    (at 12.00 42.00 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "f7097d81-31ac-4da8-a187-4ae47eeb3c12")
  )

  (text "VCAP pins each get 2.2 uF. VDD/VDDUSB/VDDIO2/VBAT are tied to P3V3 for this first spin."
    (at 12.00 52.00 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "8d8b4312-df75-4402-a846-e2d8aed7227c")
  )

